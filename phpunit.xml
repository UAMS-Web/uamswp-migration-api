<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         failOnEmptyTestSuite="true"
         beStrictAboutOutputDuringTests="true">
    <!--
        The unit suite only, on Pest 5, with no WordPress and no database: a unit
        test that reaches for a WordPress function dies with an undefined-function
        error rather than passing against a core that happened to be loaded.

        The Integration suite is not here. It runs in its own process from its own
        Composer setup, tests/Integration/composer.json and
        tests/Integration/phpunit.xml (composer test:integration), because WordPress'
        test bootstrap cannot install beside PHPUnit 13 (#375).
    -->
    <testsuites>
        <testsuite name="Unit">
            <directory suffix="Test.php">./tests/Unit</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">./includes</directory>
        </include>
    </source>
</phpunit>
