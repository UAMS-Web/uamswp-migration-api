class FrmFormAction
{
    /**
     * The query the plugin uses to select a form's actions. Public, and a
     * builder rather than a reader, which is why the endpoint calls it: the
     * post type and the key column stay the plugin's knowledge. Its defaults
     * are copied here because the endpoint overrides two of them (D-081):
     * `post_status` pins `publish`, so a draft notification vanishes, and
     * `$limit` caps at 99.
     *
     * @param  int  $form_id  The plugin also takes `'all'` here; nothing in this repo passes it.
     * @param  int  $limit
     * @return array{post_type: string, post_status: string, numberposts: int, orderby: string, order: string, menu_order?: int}
     */
    public static function action_args($form_id = 0, $limit = 99)
    {
    }

    /**
     * The runtime reader the endpoint deliberately does NOT use, declared so
     * the test that proves the divergence can call it. Selects published
     * actions only, drops any whose type is not registered on the serving
     * site, and merges the type's defaults into each one's settings.
     *
     * @param  int|string  $form_id
     * @param  string  $type  `'all'`, or one action type.
     * @param  array<string, mixed>  $atts  `limit` and `post_status`, both defaulted inside.
     * @return array<int, WP_Post>|WP_Post Returns a BARE object when the limit resolves to 1.
     */
    public static function get_action_for_form($form_id, $type = 'all', $atts = [])
    {
    }
}

