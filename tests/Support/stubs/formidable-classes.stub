<?php

/**
 * Formidable Forms, by signature only, for static analysis.
 *
 * A stub rather than `scanDirectories`, for the reason the ACF Custom Database
 * Tables and Gravity Forms stubs beside it give: the plugin is paid, is not a
 * Composer package, and is absent on CI, so pointing the analyzer at its
 * directory would red every remote run.
 *
 * Only what this repo calls is declared, and the defaults are copied exactly
 * from the plugin — they are the point. `get_published_forms()` is declared
 * here even though nothing calls it, so the analyzer can see why: three
 * defaults that each drop data from a migration (D-046).
 *
 * Never loaded at runtime. The `.stub` extension keeps it out of `paths`
 * analysis and nothing requires it, so the real classes are what execute.
 */
class FrmForm
{
    /**
     * @param  int|string  $id
     * @param  int|false  $blog_id
     * @return stdClass|false Applies NO status filter — a trashed form comes back like any other.
     */
    public static function getOne($id, $blog_id = false)
    {
    }

    /**
     * @param  array<string, mixed>|string  $where
     * @param  string  $order_by
     * @param  string|int  $limit  `''` means no limit. `0` compiles to `LIMIT 0` and returns nothing.
     * @return array<int, stdClass>|stdClass|null Returns a BARE object, not a list, when `$limit` is `1`
     *         or `' LIMIT 1'` — the method `reset()`s the result in that case.
     */
    public static function getAll($where = [], $order_by = '', $limit = '')
    {
    }

    /**
     * The call this repo deliberately does NOT use. Each default drops data:
     * `$limit` caps at 999, `$inc_children` hides child forms, and the query
     * pins `status` so drafts vanish. See D-046.
     *
     * @param  array<string, mixed>  $query
     * @param  int  $limit
     * @param  string  $inc_children
     * @return array<int, stdClass>
     */
    public static function get_published_forms($query = [], $limit = 999, $inc_children = 'exclude')
    {
    }

    /**
     * @param  array<string, mixed>  $values
     * @return int|false
     */
    public static function create($values)
    {
    }

    /**
     * @param  int  $id
     * @return bool
     */
    public static function trash($id)
    {
    }
}

class FrmField
{
    /**
     * @param  int  $form_id
     * @param  string|int  $limit  `''` means no limit.
     * @param  string  $inc_embed  Defaults to `'exclude'`, which omits embedded-form fields.
     * @param  string  $inc_repeat
     * @return array<int, stdClass>
     */
    public static function get_all_for_form($form_id, $limit = '', $inc_embed = 'exclude', $inc_repeat = 'include')
    {
    }

    /**
     * @param  array<string, mixed>  $values
     * @return int|false
     */
    public static function create($values)
    {
    }
}

class FrmMigrate
{
    /**
     * Creates or updates Formidable's tables. Normally runs on activation; the
     * test bootstrap calls it explicitly, because it never activates anything.
     */
    public function upgrade(): void
    {
    }
}

