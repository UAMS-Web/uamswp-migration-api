{
  "uams-statamic": {
    "_spell": "cspell:ignore gitlink .",
    "base": "main",
    "php": "8.4",
    "jobs": [
      {
        "name": "mutate",
        "run": "vendor/bin/pest tests/Unit/Support/UamsAlert/AlertSiteKeyResolverTest.php --mutate --path=app/Support/UamsAlert --class=\"App\\Support\\UamsAlert\\AlertSiteKeyResolver\" --covered-only",
        "mutation": { "minScore": 100 },
        "paths": ["app/**", "tests/**", "phpunit.xml*", "composer.lock"],
        "requires": ["vendor/bin/pest"]
      },
      {
        "name": "build",
        "run": "npm run build && npm run cp:build",
        "paths": ["resources/**", "package.json", "package-lock.json", "vite*.js"],
        "requires": ["node_modules", "bin:npm"]
      },
      {
        "name": "js",
        "run": "npm run test:js",
        "paths": ["resources/**", "package.json", "package-lock.json", "vitest.config.js"],
        "requires": ["node_modules", "bin:npm"]
      },
      {
        "name": "spell",
        "run": "npm run spell",
        "paths": ["**/*.md", "cspell.json", "project-words.txt", "scripts/spell.mjs", "package-lock.json"],
        "requires": ["cspell.json", "node_modules", "bin:npm"]
      },
      {
        "name": "browser",
        "run": "vendor/bin/pest tests/Browser",
        "paths": ["app/**", "resources/**", "tests/Browser/**", "composer.lock", "package-lock.json"],
        "requires": ["vendor/bin/pest", "node_modules", "public/build/manifest.json"]
      },
      {
        "name": "composer-validate",
        "run": "composer validate --no-check-publish --no-check-all",
        "paths": ["composer.json", "composer.lock"],
        "requires": ["bin:composer"]
      },
      {
        "name": "no-emoji-guard",
        "run": "node scripts/check-no-emoji.mjs",
        "always": true,
        "requires": ["scripts/check-no-emoji.mjs", "bin:node"]
      },
      {
        "name": "encoding-guard",
        "run": "node vendor/joshdaugherty/ipa-unicode-inventory/scripts/check-double-encoding.mjs && node scripts/check-decision-log-order.mjs && php scripts/check-mutate-ignore.php app tests && node scripts/check-lone-cr.mjs",
        "always": true,
        "requires": ["vendor/joshdaugherty/ipa-unicode-inventory/scripts/check-double-encoding.mjs", "scripts/check-decision-log-order.mjs", "scripts/check-mutate-ignore.php", "scripts/check-lone-cr.mjs"]
      },
      {
        "name": "test-isolation-guard",
        "run": "php scripts/check-parallel-safe-tests.php",
        "paths": ["tests/**", "scripts/check-parallel-safe-tests.php"],
        "requires": ["scripts/check-parallel-safe-tests.php"]
      }
    ]
  },
  "wordpress-importer": {
    "base": "main",
    "php": "8.4",
    "jobs": [
      {
        "name": "validate",
        "run": "composer validate --no-check-publish --no-check-all",
        "paths": ["composer.json", "composer.lock"],
        "requires": ["bin:composer"]
      },
      {
        "name": "spell",
        "run": "npm run spell",
        "paths": ["**/*.md", "cspell.json", "project-words.txt", "package-lock.json"],
        "requires": ["cspell.json", "node_modules", "bin:npm"]
      },
      {
        "name": "node-test",
        "run": "node --test",
        "each": ["scripts/*.test.mjs"],
        "requires": ["bin:node"]
      },
      {
        "name": "python-test",
        "run": "node scripts/python-tests.mjs",
        "paths": ["**/*.py", "scripts/python-tests.mjs"],
        "requires": ["scripts/python-tests.mjs", "bin:node"]
      },
      {
        "name": "mutate-ignore-breadth",
        "run": "php .claude/skills/pest-testing/scripts/check-mutate-ignore-breadth.php",
        "paths": ["**/*.php", "!vendor/**", "tests/mutate-ignore-breadth.baseline.json", "composer.lock"],
        "requires": ["vendor/pestphp/pest-plugin-mutate", ".claude/skills/pest-testing/scripts/check-mutate-ignore-breadth.php"]
      }
    ]
  },
  "uamswp-migration-api": {
    "base": "main",
    "php": "8.2",
    "jobs": [
      {
        "name": "load-guard",
        "run": "php scripts/check-no-vendor-dependency.php",
        "always": true,
        "requires": ["scripts/check-no-vendor-dependency.php"]
      },
      {
        "name": "validate",
        "run": "composer validate --no-check-publish --no-check-all",
        "paths": ["composer.json", "composer.lock"],
        "requires": ["bin:composer"]
      },
      {
        "name": "glyph",
        "run": "node scripts/check-no-glyphs.mjs",
        "always": true,
        "requires": ["scripts/check-no-glyphs.mjs", "bin:node"]
      },
      {
        "name": "spell",
        "run": "npm run spell",
        "paths": ["**/*.{php,js,mjs,md,yml,yaml,json}", "cspell.json", "project-words.txt", "package-lock.json"],
        "requires": ["cspell.json", "node_modules", "bin:npm"]
      },
      {
        "name": "node-test",
        "run": "node --test",
        "each": ["scripts/*.test.mjs"],
        "requires": ["bin:node"]
      },
      {
        "name": "mutate-ignore-breadth",
        "run": "php .claude/skills/pest-testing/scripts/check-mutate-ignore-breadth.php",
        "paths": ["**/*.php", "!vendor/**", "tests/mutate-ignore-breadth.baseline.json", "composer.lock"],
        "requires": ["vendor/pestphp/pest-plugin-mutate", ".claude/skills/pest-testing/scripts/check-mutate-ignore-breadth.php"]
      }
    ]
  }
}
